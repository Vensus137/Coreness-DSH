{
  "name": "@coreness/dsh",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "description": "The Coreness product for a DeepSeek Harness profile (new tree).",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dependencies": {
    "@coreness/ui": "file:./vendor/ui",
    "@coreness/journal": "file:./vendor/journal",
    "@coreness/rules": "file:./vendor/rules",
    "@coreness/mcp": "file:./vendor/mcp",
    "@coreness/oauth": "file:./vendor/oauth",
    "@coreness/qoder": "file:./vendor/qoder",
    "@coreness/rate-gate": "file:./vendor/rate-gate"
  },
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "README.md",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "vendor"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
